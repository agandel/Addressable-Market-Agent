# Required
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Web search (Brave Search API)
BRAVE_SEARCH_API_KEY=your-brave-key-here

# Optional: Override default model (claude-sonnet-4-20250514)
TAM_AGENT_MODEL=claude-sonnet-4-20250514

# Optional: Max web searches per analysis run
TAM_AGENT_MAX_SEARCHES=20
